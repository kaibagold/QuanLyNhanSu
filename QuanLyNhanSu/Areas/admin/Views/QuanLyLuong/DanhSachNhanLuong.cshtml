@model IEnumerable<QuanLyNhanSu.Models.ChiTietLuong>
@{
    ViewBag.Title = "Danh sách nhận lương";
}


<div class="">
    <div class="">
        <h1 class="page-header">
            Danh sách Lương nhân viên
        </h1>
        <ol class="breadcrumb">
            <li>
                <i class="fa fa-dashboard"></i> <a href="@Url.Action("index","Admin")">Tổng quan</a>
            </li>
            <li>
                <i class="fa fa-money"></i><a href="@Url.Action("index","QuanLyLuong")"> Thông tin lương</a>
            </li>
            <li>
                <i class="fa "></i> Danh sách lương
            </li>
        </ol>
    </div>
</div>
<div style="margin:10px">

    <div class="form-group">
        @{
            if (Session["selectedMonth"] == null)
            {
                <a class="btn btn-primary" href="@Url.Action("XuatFileLuong", "QuanLyLuong")"> Xuất file</a>
            }
            else
            {
                <a class="btn btn-primary" href="@Url.Action("XuatFileLuong", "QuanLyLuong", new {@id = Session["selectedMonth"] })"> Xuất file</a>
            }
        }
        <select name="thang" id="thang" style="width: 130px; height: 33px">
            <option value="">-- Chọn tháng --</option>
            <option value="1">Tháng 1</option>
            <option value="2">Tháng 2</option>
            <option value="3">Tháng 3</option>
            <option value="4">Tháng 4</option>
            <option value="5">Tháng 5</option>
            <option value="6">Tháng 6</option>
            <option value="7">Tháng 7</option>
            <option value="8">Tháng 8</option>
            <option value="9">Tháng 9</option>
            <option value="10">Tháng 10</option>
            <option value="11">Tháng 11</option>
            <option value="12">Tháng 12</option>
        </select>
    </div>
</div>

<div class="table-responsive">
    <table id="table-taikhoan" class="table table-striped table-hover table-bordered ">
        <thead>
            <tr class="success">
                <th>
                    Mã nhân viên
                </th>

                <th>
                    Lương cơ bản
                </th>
                <th>
                    Bảo hiểm
                </th>
                <th>
                    Phụ cấp
                </th>
                <th>
                    Thuế thu nhập
                </th>
                @*<th>
                        Tiền thưởng
                    </th>
                    <th>
                        Tiền phạt
                    </th>*@
                <th>
                    Ngày nhận lương
                </th>
                <th>
                    Thực lãnh
                </th>

            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.MaNhanVien)
                    </td>

                    <td>
                        @string.Format("{0:#,#}", @item.LuongCoBan).Replace(",", ",")

                    </td>
                    <td>
                        <table class="table table-bordered">
                            <tr><th>XH</th><th>YT</th><th>TN</th></tr>
                            <tr>
                                <td>@string.Format("{0:#,#}", @item.BHXH).Replace(",", ",")</td>
                                <td>@string.Format("{0:#,#}", @item.BHYT).Replace(",", ",")</td>
                                <td>@string.Format("{0:#,#}", @item.BHTN).Replace(",", ",")</td>
                            </tr>
                        </table>
                    </td>
                    <td>
                        @string.Format("{0:#,#}", @item.PhuCap).Replace(",", ",")

                    </td>
                    <td>
                        @string.Format("{0:#,#}", @item.ThueThuNhap).Replace(",", ",")

                    </td>
                    @*<td>
                            @string.Format("{0:#,#}", @item.TienThuong).Replace(",", ",")

                        </td>
                        <td>

                            @string.Format("{0:#,#}", @item.TienPhat).Replace(",", ",")
                        </td>*@
                    <td>
                        @String.Format("{0:dd/MM/yyyy}", @item.NgayNhanLuong)
                    </td>
                    <td>
                        @{
                            var t = decimal.Parse(item.TongTienLuong);
                        }

                        @String.Format("{0:#,#}", t).Replace(",", ",")
                    </td>

                </tr>
            }
        </tbody>
    </table>

</div>

@section scripts {
    <script>
         // Lấy thẻ select
    const monthSelect = document.getElementById('thang');
        // Hàm lấy tham số tháng từ URL
        function getURLParam(param) {
            const urlParams = new URLSearchParams(window.location.search);
            return urlParams.get(param);
        }
        // Thiết lập giá trị tháng khi tải trang
        const selectedMonth = getURLParam('month');
        if (selectedMonth) {
            monthSelect.value = selectedMonth; // Gán giá trị đã chọn vào thẻ select tháng
        }
        // Gắn sự kiện change
        monthSelect.addEventListener('change', function() {
          // Lấy giá trị được chọn
          const selectedMonth = monthSelect.value;
          // Nếu người dùng chọn một tháng (không phải giá trị mặc định)
          if (selectedMonth) {
            // Thêm giá trị tháng vào URL dưới dạng tham số
            const url = new URL(window.location.href);
              url.searchParams.set('month', selectedMonth);
            // Load lại trang với URL mới
              window.location.href = url.toString();
          }
    });
    </script>
}