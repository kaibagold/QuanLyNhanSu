@using QuanLyNhanSu.Models
@model List<NhanVien>

@{
    ViewBag.Title = "Nhân viên";
}
@{
    QuanLyNhanSuEntities db = new QuanLyNhanSuEntities();
    var td = db.TrinhDoHocVans.ToList();
}

<div class="">
    <div class="">
        <h1 class="page-header">
            Nhân viên
        </h1>
        <ol class="breadcrumb">
            <li>
                <i class="fa fa-dashboard"></i> <a href="@Url.Action("index","Admin")">Tổng quan</a>
            </li>
            <li>
                <i class="fa fa-user"></i> @*<a href="@Url.Action("index","QuanLyUser")">Nhân viên</a>*@
                Nhân viên
            </li>
        </ol>
    </div>
</div>

<div>
    <div style="padding:10px">
        <a class="btn btn-primary" href="@Url.Action("ThemUser", "QuanLyUser")">
            Thêm nhân viên
        </a>


    </div>
</div>



@*Phân trang, tìm kiếm sử dụng datatable.min.js*@
<div class="table-responsive">
    <table id="table-taikhoan" class="table table-bordered table-striped table-hover">
        <thead>
            <tr class="success">
                <th>
                    Mã nhân viên
                </th>
                <th>
                    Họ tên
                </th>
                <th>
                    Trình độ văn hóa
                </th>
                <th>
                    Trạng Thái
                </th>
                <th>
                    Ngày bắt đầu
                </th>
                <th>
                    Số lượng: @Model.Count
                </th>

            </tr>
        </thead>
        <tbody>
            @{
                foreach (var item in Model)
                {
                    string tenTrinhDo = string.Empty;
                    string gioitinh = string.Empty;
                    switch (item.GioiTinh)
                    {
                        case 0:
                            gioitinh = "Nữ";
                            break;
                        case 1:
                            gioitinh = "Nam";
                            break;
                        default:
                            gioitinh = "Khác";
                            break;
                    }


                    foreach (var t in td)
                    {
                        if (t.MaTrinhDoHocVan.Equals(item.MaTrinhDoHocVan))
                        {
                            tenTrinhDo = t.TenTrinhDo;
                            break;
                        }
                    }

                    <tr>
                        <td>@item.MaNhanVien</td>
                        <td>@item.HoTen</td>
                        <td>@tenTrinhDo</td>
                        <td>
                            @{if (item.TrangThai)
                                {
                                    <span class="status-text" style="color: green">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="status-text" style="color: red">Thôi việc</span>
                                }
                            }
                        </td>
                        <td>
                            @String.Format("{0:dd/MM/yyyy}", @item.HopDong.NgayBatDau)
                            @{
                                DateTime ngaydau = Convert.ToDateTime(@item.HopDong.NgayBatDau);
                                DateTime ngaysau = DateTime.Now.Date;
                                TimeSpan Times = ngaysau - ngaydau;

                                int sonam = (int)Times.Days / 365;

                            }

                        </td>
                        <td>
                            <a class="btn btn-info" href="@Url.Action("QuaTrinhHoc", "QuanLyUser", new { @id = @item.MaNhanVien})">Chi Tiết</a>
                            <a class="btn btn-warning" href="@Url.Action("UpdateUser", "QuanLyUser", new {@id = @item.MaNhanVien })"><i class="fa fa-pencil-square-o x5" aria-hidden="true"></i>Sửa</a>
                            <a class="btn btn-danger" style="display:none" href="@Url.Action("XoaUser", "QuanLyUser", new { @id = @item.MaNhanVien })"><i class="fa fa-trash-o"></i>Xóa</a>
                            <a class="btn btn-success toggle-status-btn" data-user-id="@item.MaNhanVien"><i class="fa fa-lock "></i> Hoạt Động/Khóa</a>
                        </td>
                    </tr>
                }
            }

        </tbody>
    </table>
</div>


<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script>
$(document).ready(function () {
            // Khi người dùng nhấn nút đổi trạng thái
            $('.toggle-status-btn').click(function () {
                const userId = $(this).data('user-id'); // Lấy ID của user
                const $row = $(this).closest('tr'); // Dòng hiện tại

                // Gửi yêu cầu Ajax đến server
                $.ajax({
                    url: '/QuanLyUser/CapNhatTrangThai',
                    type: 'POST',
                    data: { id: userId },
                    success: function (response) {
                        if (response.success) {
                            // Cập nhật trạng thái trên giao diện
                            const statusText = response.status ? "Hoạt động" : "Thôi việc";
                            const statusTextColor = response.status ? "green" : "red";
                            $row.find('.status-text').text(statusText);
                            $row.find('.status-text').css('color', statusTextColor ); // Thay đổi màu chữ thành màu xanh lá hoặc đỏ
                        } else {
                            alert("Có lỗi xảy ra khi cập nhật trạng thái.");
                        }
                    },
                    error: function () {
                        alert("Yêu cầu thất bại. Vui lòng thử lại.");
                    }
                });
            });
        });</script>

