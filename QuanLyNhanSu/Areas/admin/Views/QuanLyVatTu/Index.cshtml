@using QuanLyNhanSu.Models
@model List<VatTu>

@{
    ViewBag.Title = "Vật tư";
}
@{
    QuanLyNhanSuEntities db = new QuanLyNhanSuEntities();
}

<div class="">
    <div class="">
        <h1 class="page-header">
            Danh sách vật tư
        </h1>
        <ol class="breadcrumb">
            <li>
                <i class="fa fa-dashboard"></i> <a href="@Url.Action("index","Admin")">Tổng quan</a>
            </li>
            <li>
                <i class="fa fa-user"></i>
                Vật tư
            </li>
        </ol>
    </div>
</div>

<div>
    <div style="padding:10px">
        <a class="btn btn-primary" href="@Url.Action("ThemVatTu", "QuanLyVatTu")">
            Thêm vật tư
        </a>
        <a class="btn btn-info" href="@Url.Action("VatTuCaNhan", "QuanLyVatTu")">
            Vật tư cá nhân
        </a>
    </div>
</div>



@*Phân trang, tìm kiếm sử dụng datatable.min.js*@
<div class="table-responsive">
    <table id="table-taikhoan" class="table table-bordered table-striped table-hover">
        <thead>
            <tr class="success">
                <th>
                    Mã vật tư
                </th>
                <th>
                    Tên vật tư
                </th>
                <th>
                    Đơn vị tính
                </th>
                <th>
                    Số lượng
                </th>
                <th>
                    Tình Trạng
                </th>
                <th>
                    Số lượng: @Model.Count
                </th>

            </tr>
        </thead>
        <tbody>
            @{
                foreach (var item in Model)
                {
                        <tr>
                            <td>@item.MaVatTu</td>
                            <td>@item.TenVatTu</td>
                            <td>@item.DonViTinh</td>
                            <td>@item.SoLuong</td>
                            <td>
                                @{if (item.TrangThai == 0)
                                    {
                                        <span class="status-text" style="color: green">Cũ</span>
                                    }
                                    if (item.TrangThai == 1)
                                    {
                                        <span class="status-text" style="color: green">Mới</span>
                                    }
                                    if (item.TrangThai == 2)
                                    {
                                        <span class="status-text" style="color: red">Ngừng hđ</span>
                                    }
                                }
                            </td>
                            <td>
                                <a class="btn btn-warning" href="@Url.Action("SuaVatTu", "QuanLyVatTu", new {@id = @item.MaVatTu })"><i class="fa fa-pencil-square-o x5" aria-hidden="true"></i>Sửa</a>
                                <a class="btn btn-success toggle-status-btn" data-user-id="@item.MaVatTu"><i class="fa fa-lock "></i> Hoạt Động/Khóa</a>
                            </td>
                        </tr>
                }
            }

        </tbody>
    </table>
</div>


<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script>
$(document).ready(function () {
            // Khi người dùng nhấn nút đổi trạng thái
            $('.toggle-status-btn').click(function () {
                const userId = $(this).data('user-id'); // Lấy ID của user
                const $row = $(this).closest('tr'); // Dòng hiện tại
                var statusText = "";
                var statusTextColor = "";
                // Gửi yêu cầu Ajax đến server
                $.ajax({
                    url: 'QuanLyVatTu/CapNhatTrangThai',
                    type: 'POST',
                    data: { id: userId },
                    success: function (response) {
                        if (response.success) {
                            // Cập nhật trạng thái trên giao diện
                            if (response.status == 2) {
                                 statusText = "Ngừng hđ";
                                 statusTextColor = "red";
                            }
                            else {
                                statusText = "Cũ";
                                statusTextColor = "green";
                            }
                            $row.find('.status-text').text(statusText);
                            $row.find('.status-text').css('color', statusTextColor ); // Thay đổi màu chữ thành màu xanh lá hoặc đỏ
                        } else {
                            alert("Có lỗi xảy ra khi cập nhật trạng thái.");
                        }
                    },
                    error: function () {
                        alert("Yêu cầu thất bại. Vui lòng thử lại.");
                    }
                });
            });
        });</script>

