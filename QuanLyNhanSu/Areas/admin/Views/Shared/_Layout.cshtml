<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title-Admin</title>
    @Styles.Render("~/Content/Admin/css")
    @Scripts.Render("~/bundles/modernizr")
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style type="text/css">
        .edit-row {
            margin-left: 0;
            margin-right: 10px;
            /* padding: 10px;*/
            height: 100%;
        }

        .active {
            background: #fc7321;
            color: red;
        }
    </style>

</head>
<body>
    <div id="wrapper">
        <nav class="navbar navbar-inverse navbar-fixed-top" role="navigation" style="background-color: #fc7321; color:white;height:70px ">
            <!-- Brand and toggle get grouped for better mobile display -->
            <div class="" style="color:white">
                <a href="http://localhost:29496/admin/Admin"><img style="height:65px;margin-left:50px" src="~/Content/anh/logo_admin.png" /></a>
            </div>
            <!-- Top Menu Items -->
            <ul class="navvv navbar-right top-nav">
                <li class="">
                    <a href="#" data-toggle="dropdown" style="font-size:15px;">
                        <i class="fa fa-user"></i> Admin <b class="caret"></b>
                    </a>
                    <ul class="dropdown-menu">
                        @*<li>
                                <a href="#"><i class="fa fa-fw fa-user"></i> Profile</a>
                            </li>*@
                        @*<li>
                                <a href="#"><i class="fa fa-exchange"></i>  Đổi mật khẩu</a>
                            </li>*@
                        <li>
                            <a href="#"><i class="fa fa-fw fa-envelope"></i> Tin nhắn</a>
                        </li>
                        <li>
                            <a href="#"><i class="fa fa-fw fa-gear"></i> Cài đặt</a>
                        </li>
                        <li class="divider"></li>
                        <li>
                            <a onclick="confirmLogout()" style="cursor:pointer">
                                <i class="fa fa-fw fa-power-off"></i> Đăng xuất
                            </a>
                        </li>
                    </ul>
                </li>
            </ul>
            <!-- Sidebar Menu Items - These collapse to the responsive navigation menu on small screens -->
            <div class="collapse navbar-collapse navbar-ex1-collapse">
                <ul class="nav navbar-nav side-nav" id="activeMenu" style="margin-top: 19px; ">
                    <li class="active">
                        <a href="@Url.Action("index","Admin")"><i class="fa fa-fw fa-dashboard"></i> Tổng quan</a>
                    </li>
                    <li>
                        <a href="@Url.Action("index","QuanLyUser")"><i class="fa fa-fw fa-user"></i> Nhân Viên</a>
                    </li>
                    <li>
                        <a href="@Url.Action("index", "QuanLyPhongBan")"><i class="fa fa-tasks"></i> Phòng ban</a>
                    </li>
                    <li>
                        <a href="@Url.Action("index","QuanLyLuong")"><i class="fa fa-money"></i> Lương nhân viên</a>
                    </li>
                    <li>
                        <a href="@Url.Action("index","KhenThuong")"><i class="fa fa-money"></i> Khen thưởng</a>
                    </li>
                    <li>
                        <a href="@Url.Action("index","ThongKe")"><i class="fa fa-bar-chart"></i> Thống kê</a>
                    </li>
                    <li class="treeview">
                        <a href="#" style="">
                            <i class="fa fa-bars"></i>
                            <span>Triển Khai</span>
                            <span class="pull-right-container">
                                <i class="fa fa-angle-down pull-right"></i>
                            </span>
                        </a>
                        <ul class="treeview-menu">
                            <li>
                                <a href="@Url.Action("index","TrienKhaiSwap")" style="color:white">
                                    <i class="fa fa-plus-square"></i> Triển Khai Swap
                                </a>
                            </li>
                            <li>
                                <a href="#" style="color:white">
                                    <i class="fa fa-plus-square"></i> Triển Khai Mới
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
            <!-- /.navbar-collapse -->
        </nav>
        <div id="page-wrapper">
            @RenderBody()
            <hr />
            <footer>
                <p>&copy; @DateTime.Now.Year - Admin</p>

            </footer>
        </div>

    </div>
    <div style="right: 0;
    position: fixed;
    bottom: 0;
    margin-bottom: 0;" id="bot">
        <a id="top" style="float:right;margin:10px" class="btn btn-danger">
            <span class="glyphicon glyphicon-arrow-up">
            </span>
        </a>
    </div>

    @Scripts.Render("~/bundles/adminlte/js")
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/datatable") @*Phân trang*@
    @Scripts.Render("~/bundles/bootstrap")@*Phân trang*@
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.4/Chart.js"></script>
    <script src="https://cdn.jsdelivr.net/gh/emn178/chartjs-plugin-labels/src/chartjs-plugin-labels.js"></script>
    @RenderSection("scripts", required: false)
    <script>

        //  $('#top').hide(500);
        $(window).on('scroll', function () {
            var scrollTop = $(window).scrollTop();
            if (scrollTop > 0) {
                $('#top').show(500);
                //$('#top').fadeIn(500);
            } else {
                //$('#top').fadeOut(500);
                $('#top').hide(500);
            }
        });

        $('#top').on('click', function (e) {
            $('html,body').animate({ scrollTop: 0 }, "slow");
        });

        function confirmLogout() {
            // Hiển thị hộp thoại xác nhận
            if (confirm("Bạn muốn đăng xuất?")) {
                // Nếu chọn "OK", chuyển hướng đến action đăng xuất
                window.location.href = "http://localhost:29496/admin/Admin/DangXuat"; // Đường dẫn đến Action Logout
            }
            // Nếu chọn "Cancel", không làm gì
        }
        $(document).ready(function () {
            $('.treeview').on('click', function () {
                $(this).toggleClass('active');
                $(this).find('.treeview-menu').slideToggle();
            });
        });
    </script>
</body>
</html>