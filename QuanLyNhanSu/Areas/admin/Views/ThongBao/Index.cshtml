@using QuanLyNhanSu.Models
@using QuanLyNhanSu.Areas.admin.Controllers;
@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/admin/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/MaterialDesign-Webfont/5.3.45/css/materialdesignicons.css" integrity="sha256-NAxhqDvtY0l4xn+YVa6WjAcmd94NNfttjNsDmNatFVc=" crossorigin="anonymous" />
<style>
    body {
        background-color: #f0f2f5;
    }

    .dropdown-list-image {
        position: relative;
        height: 40px;
        width: 40px;
    }

        .dropdown-list-image img {
            height: 40px;
            width: 40px;
        }

    .btn-light {
        color: #2cdd9b;
        background-color: #e5f7f0;
        border-color: #d8f7eb;
    }

    .notification-item {
        cursor: pointer;
        display: flex;
        border: 2px double;
        background-color: floralwhite;
        margin: 5px;
    }

        .notification-item :hover {
        }

    .TimeSinceNotification {
        margin: 8px auto auto -14px;
        width: 130px;
        opacity: 0.5;
    }
</style>
<div class="container">
    <div style="margin-top:10px">
        <h1 class="page-header">
            Thông Báo
        </h1>
        <ol class="breadcrumb">
            <li>
                <i class="fa fa-dashboard"></i> <a href="@Url.Action("index","Admin")">Tổng quan</a>
            </li>
            <li>
                <i class="fa fa-bell"></i> Thông Báo
            </li>
        </ol>
    </div>
    <div class="row">
        <div class="col-lg-9 right">
            <div class="box shadow-sm rounded bg-white mb-3" style="background-color: aliceblue">
                <div class="box-title border-bottom p-3">
                    <h6 class="m-0">Recent</h6>
                </div>
                <div class="box-body p-0">
                    @{
                        QuanLyNhanSuEntities db = new QuanLyNhanSuEntities();
                        var nv = db.NhanViens.ToList();
                        foreach (var item in Model)
                        {
                            string colorThongBao, loaiThongBao = "";
                            string avtNhanVien = nv.Where(n => n.MaNhanVien == item.MaNVGuiTB).Select(n=>n.HinhAnh).FirstOrDefault();
                            if (item.TrangThai == 0)
                            {
                                colorThongBao = "floralwhite";//chưa đọc
                            }
                            else
                            {
                                colorThongBao = "white";//đã đọc
                            }
                            if (item.LoaiThongBao == "xuatvattu")
                            {
                                loaiThongBao = item.MaNVGuiTB + " đề nghị xuất vật tư";
                            }
                            else
                            {
                                loaiThongBao = item.MaNVGuiTB + " đề nghị cấp lại mật khẩu";
                            }
                            <a href="@Url.Action("ChiTietPhieuNhap", "ThongBao", new {@id = @item.Id })" style="color:black;display:flex">
                                <div class="p-3 notification-item" style="background-color:@colorThongBao">
                                    <div class="dropdown-list-image mr-3">
                                        <img class="rounded-circle" style="border-radius: 50%;border:1px solid " src="~/Content/anh/img_avt/@avtNhanVien" alt="" />
                                    </div>
                                    <div class="font-weight-bold mr-3" style="margin-left: 10px;width:500px">
                                        <div class="text-truncate" style="font-weight: bold; text-transform: uppercase;">TIÊU ĐỀ: @item.TieuDe</div>
                                        <div class="small">@loaiThongBao</div>
                                    </div>
                                    <div class="TimeSinceNotification">@ThongBaoController.GetTimeSinceNotification(item.ThoiGianGuiTB)</div>
                                    <span class="ml-auto mb-auto" style="margin-right:0px">
                                        <div class="btn-group">
                                            <button type="button" class="btn btn-light btn-sm rounded" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                                <i class="mdi mdi-dots-vertical"></i>
                                            </button>
                                            <div class="dropdown-menu dropdown-menu-right">
                                                <button class="dropdown-item" type="button"><i class="mdi mdi-delete"></i> Xóa thông báo</button>
                                                <button class="dropdown-item" type="button"><i class="mdi mdi-close"></i> <a href="@Url.Action("DanhDauChuaDoc","ThongBao")">Đánh dấu chưa đọc</a></button>
                                            </div>
                                        </div>
                                        <br />

                                    </span>
                                </div>
                            </a>
                        }
