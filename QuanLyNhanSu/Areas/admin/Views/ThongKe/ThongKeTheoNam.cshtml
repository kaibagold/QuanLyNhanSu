@model QuanLyNhanSu.Models.ThongKeViewModel
@{
    ViewBag.Title = "Thống kê theo năm";
    Layout = "~/Areas/admin/Views/Shared/_Layout.cshtml";
}

<style>
    .col-6 {
        margin: 10px;
        background-color: #f1f2f1;
        border-radius: 10px
    }

    .inputYear {
        background-color: #f1f2f1;
        border-radius: 10px;
        margin-left: 60px;
        width: 90px;
    }
</style>
<div class="margin-bottom:5px">
    <div class="">
        <h1 class="page-header">
            Thống Kê
        </h1>
        <ol class="breadcrumb">
            <li>
                <i class="fa fa-dashboard"></i> <a href="@Url.Action("index","Admin")">Tổng quan</a>
            </li>
            <li>
                <i class="fa fa-area-chart"></i>
                Thống kê
            </li>
        </ol>
    </div>
</div>
<input type="number" class="inputYear" id="yearInput" placeholder="Nhập năm" min="1900" max="2100" />
<div class="container" style="">
    <div class="row" style="display:flex;flex-direction:row">
        <div class="col-6" style="width: 500px">
            <!-- Thẻ col đầu tiên -->
            <h3 style="text-align: center;">Thống Kê Lương Theo Tháng</h3>
            <canvas id="myChart"></canvas>
        </div>
        <div class="col-6" style="width: 500px">
            <!-- Thẻ col thứ hai -->
            <h3 style="text-align: center;">Thống Kê Lương Theo Quý</h3>
            <canvas id="salaryChart"></canvas>
        </div>
    </div>
    <div class="row" style="display:flex;flex-direction:row">
        <div class="col-6" style="width: 500px">
            <!-- Thẻ col đầu tiên -->
            <h3 style="text-align: center;">Thống Kê Lương Theo Phòng Ban</h3>
            <canvas id="salaryChartPb"></canvas>
        </div>
        <div class="col-6" style="width: 500px">
            <!-- Thẻ col thứ hai -->
            <h3 style="text-align: center;">Thống Kê Lương Theo Quý</h3>
            <canvas id="salaryChart"></canvas>
        </div>
    </div>
    Tổng chi : <b>@String.Format("{0:#,#}", Model.TongChi).Replace(",", ",") đ</b>
</div>


@section scripts {
    <script>
        var xValues = ["Tháng 1", "Tháng 2", "Tháng 3", "Tháng 4", "Tháng 5", "Tháng 6", "Tháng 7", "Tháng 8", "Tháng 9", "Tháng 10", "Tháng 11", "Tháng 12"];
        var xValues1 = ["Quý 1", "Quý 2", "Quý 3", "Quý 4"];
        var yValues = JSON.parse('@Html.Raw(Json.Encode(@Model.DSLuongThang))');
        var barColors = [
            "#b91d47",
            "#00aba9",
            "#2b5797",
            "#e8c3b9",
            "#36A2EB",
            "#cb2dae",
            "#f9285d",
            "#6bd7b6",
            "#edb8cf",
            "#677afc",
            "#7ece3f",
            "#347542"
        ];

        new Chart("myChart", {
            type: "pie",
            data: {
                labels: xValues,
                datasets: [{
                    backgroundColor: barColors,
                    data: yValues
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    labels: {
                        render: 'percentage',
                    }
                },
                title: {
                    display: true,
                    text: "@Html.Raw(@Model.Title)"
                }
            }
        });
        //Lương theo quý
    var ctx = document.getElementById('salaryChart').getContext('2d');
    var labels = [];
    var data = [];
    var quarterlyData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.dsLuongQuy));
    // Duyệt qua dữ liệu và thêm vào labels và data
    quarterlyData.forEach(function(item) {
        labels.push('Quý ' + item.Quarter + ' - ' + item.Year);
        data.push(item.TotalSalary);
    });
    var salaryChart = new Chart(ctx, {
        type: 'pie',
        data: {
            labels: labels,
            datasets: [{
                label: 'Tổng Tiền Lương Theo Quý',
                data: data,
                backgroundColor: [
                    'rgba(255, 99, 132, 0.2)',
                    'rgba(54, 162, 235, 0.2)',
                    'rgba(255, 206, 86, 0.2)',
                    'rgba(75, 192, 192, 0.2)',
                    'rgba(153, 102, 255, 0.2)',
                    'rgba(255, 159, 64, 0.2)'
                ],
                borderColor: [
                    'rgba(255, 99, 132, 1)',
                    'rgba(54, 162, 235, 1)',
                    'rgba(255, 206, 86, 1)',
                    'rgba(75, 192, 192, 1)',
                    'rgba(153, 102, 255, 1)',
                    'rgba(255, 159, 64, 1)'
                ],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'top',
                },
                title: {
                    display: true,
                    text: 'Thống Kê Lương Theo Quý'
                }
            }
        }
    });
        //Lương theo phòng ban
    var ctx = document.getElementById('salaryChartPb').getContext('2d');
    var labels1 = [];
    var data1 = [];
    var quarterlyData1 = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.dsLuongPhongBan));
    // Duyệt qua dữ liệu và thêm vào labels và data
    quarterlyData1.forEach(function(item) {
        labels1.push(item.MaPhongBan);
        data1.push(item.TongLuong);
    });
    var salaryChart = new Chart(ctx, {
        type: 'pie',
        data: {
            labels: labels1,
            datasets: [{
                label: 'Tổng Tiền Lương Theo Phòng Ban',
                data: data1,
                backgroundColor: [
                    'rgba(255, 99, 132, 0.2)',
                    'rgba(54, 162, 235, 0.2)',
                    'rgba(255, 206, 86, 0.2)',
                    'rgba(75, 192, 192, 0.2)',
                    'rgba(153, 102, 255, 0.2)',
                    'rgba(255, 159, 64, 0.2)',
                    "#b91d47",
                    "#00aba9",
                    "#2b5797",
                    "#e8c3b9",
                    "#36A2EB",
                    "#cb2dae",
                    "#f9285d",
                    "#6bd7b6",
                    "#edb8cf",
                    "#677afc",
                    "#7ece3f",
                    "#347542"
                ],
                borderColor: [
                    'rgba(255, 99, 132, 1)',
                    'rgba(54, 162, 235, 1)',
                    'rgba(255, 206, 86, 1)',
                    'rgba(75, 192, 192, 1)',
                    'rgba(153, 102, 255, 1)',
                    'rgba(255, 159, 64, 1)',
                    "#b91d47",
                    "#00aba9",
                    "#2b5797",
                    "#e8c3b9",
                    "#36A2EB",
                    "#cb2dae",
                    "#f9285d",
                    "#6bd7b6",
                    "#edb8cf",
                    "#677afc",
                    "#7ece3f",
                    "#347542"
                ],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'top',
                },
                title: {
                    display: true,
                    text: 'Thống Kê Lương Theo Quý'
                }
            }
        }
    });
        //Chọn năm
        $(document).ready(function () {
        $('#yearInput').on('change', function () {
            var selectedYear = $(this).val(); // Lấy giá trị năm đã chọn

            // Gửi giá trị năm đến controller thông qua AJAX
            $.ajax({
                url: '@Url.Action("ThongKeTheoNam", "ThongKe")', // Thay "YourController" bằng tên controller của bạn
                type: 'POST',
                data: { year: selectedYear },
                success: function (response) {
                    $('#message').text('Năm đã được gửi: ' + response);
                },
                error: function () {
                    $('#message').text('Không có dữ liệu.');
                }
            });
        });
    });
    </script>
}
