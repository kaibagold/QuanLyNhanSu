@using QuanLyNhanSu.Models
@model List<Swap>

@{
    ViewBag.Title = "Triển Khai Swap";
}
@{
    QuanLyNhanSuEntities db = new QuanLyNhanSuEntities();
    var td = db.TrinhDoHocVans.ToList();
}
<link href="~/Content/css/CreateSwap.css" rel="stylesheet"/>
<div class="">
    <div class="">
        <h1 class="page-header">
            Triển Khai Swap
        </h1>
        <ol class="breadcrumb">
            <li>
                <i class="fa fa-dashboard"></i> <a href="@Url.Action("index","Admin")">Tổng quan</a>
            </li>
            <li>
                <i class="fa fa-plus-square"></i> @*<a href="@Url.Action("index","QuanLyUser")">Nhân viên</a>*@
                Triển Khai
            </li>
        </ol>
    </div>
</div>

<div>
    <div style="padding:10px">
        <a class="btn btn-primary" href="@Url.Action("CreateSwap", "TrienKhaiSwap")">
            Tạo Phiếu
        </a>


    </div>
</div>



@*Phân trang, tìm kiếm sử dụng datatable.min.js*@
<div class="table-responsive">
    <table id="table-taikhoan" class="table table-bordered table-striped table-hover">
        <thead>
            <tr class="success">
                <th>
                    Mã Hợp Đồng
                </th>
                <th>
                    Khu Vực
                </th>
                <th>
                    Nhân Viên Triển Khai
                </th>
                <th>
                    Trạng Thái
                </th>
                <th>
                    Phí Dịch Vụ
                </th>
                <th>
                    Ngày Tạo
                </th>
                <th>
                    Số lượng: @Model.Count
                </th>

            </tr>
        </thead>
        <tbody>
            @{
                foreach (var item in Model)
                {
                        <tr>
                            <td>@item.MaHopDong</td>
                            <td>@item.KhuVuc</td>
                            <td>@item.MaNVTrienKhai</td>
                            <td>
                                @{if (item.TrangThai == 0)
                                    {
                                        <span class="status-text" style="color: green">Đang Chờ</span>
                                    }
                                    else
                                    {
                                        <span class="status-text" style="color: red">Đang Triển Khai</span>
                                    }
                                }
                            </td>
                            <td>@item.PhiDichVu</td>
                            <td>
                                @String.Format("{0:dd/MM/yyyy}", item.NgayTaoHD)
                            </td>
                            <td style="width: 320px;">
                                <a class="btn btn-info" href="@Url.Action("DetailUser", "QuanLyUser", new { @id = @item.Id})">Phân Ca</a>
                                <a class="btn btn-warning" href="@Url.Action("UpdateUser", "QuanLyUser", new {@id = @item.Id })"><i class="fa fa-pencil-square-o x5" aria-hidden="true"></i>Sửa Phiếu</a>
                                <a class="btn btn-danger" href="@Url.Action("XoaUser", "QuanLyUser", new { @id = @item.Id })"><i class="fa fa-trash-o"></i>Xóa Phiếu</a>
                            </td>
                        </tr>
                }
            }

        </tbody>
    </table>
</div>


<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script>
$(document).ready(function () {
            // Khi người dùng nhấn nút đổi trạng thái
            $('.toggle-status-btn').click(function () {
                const userId = $(this).data('user-id'); // Lấy ID của user
                const $row = $(this).closest('tr'); // Dòng hiện tại

                // Gửi yêu cầu Ajax đến server
                $.ajax({
                    url: '/QuanLyUser/CapNhatTrangThai',
                    type: 'POST',
                    data: { id: userId },
                    success: function (response) {
                        if (response.success) {
                            // Cập nhật trạng thái trên giao diện
                            const statusText = response.status ? "Hoạt động" : "Thôi việc";
                            const statusTextColor = response.status ? "green" : "red";
                            $row.find('.status-text').text(statusText);
                            $row.find('.status-text').css('color', statusTextColor ); // Thay đổi màu chữ thành màu xanh lá hoặc đỏ
                        } else {
                            alert("Có lỗi xảy ra khi cập nhật trạng thái.");
                        }
                    },
                    error: function () {
                        alert("Yêu cầu thất bại. Vui lòng thử lại.");
                    }
                });
            });
        });</script>

