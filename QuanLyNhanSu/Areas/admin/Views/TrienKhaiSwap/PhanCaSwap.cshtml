@{
    ViewBag.Title = "Phân Ca Swap";
}
@using QuanLyNhanSu.Models
@model SwapValidate

<div class="">
    <div class="">
        <h1 class="page-header">
            Tạo Phiếu Swap
        </h1>
        <ol class="breadcrumb">
            <li>
                <i class="fa fa-dashboard"></i> <a href="@Url.Action("index", "Admin")">Tổng quan</a>
            </li>
            <li>
                <i class="fa fa-user"></i> <a href="@Url.Action("index", "QuanLyUser")">Triển Khai</a>
            </li>
            <li>
                <i class="fa fa-user"></i>Phân Ca Swap
            </li>
        </ol>
    </div>
</div>

<div class="bg-light" style="margin-top:-20px">
    <div class="container">
        <form class="swap-form" method="post" role="form">
            @Html.ValidationSummary(true)
            <h2 class="section-title">Phân Ca Swap</h2>
            <div class="form-section">
                <h4 class="section-subtitle">Thông tin khách hàng</h4>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Mã hợp đồng<span class="required-mark">*</span></label>
                            <input type="text" class="form-control" value="@Model.MaHopDong" name="MaHopDong" maxlength="30" readonly required>
                            <div class="">@ViewBag.err @Html.ValidationMessageFor(n => n.MaHopDong)</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Tên khách hàng<span class="required-mark">*</span></label>
                            <input type="text" class="form-control" value="@Model.TenKhachHang" name="TenKhachHang" maxlength="30">
                            <div class="">@Html.ValidationMessageFor(n => n.TenKhachHang)</div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Số điện thoại</label>
                            <input type="text" class="form-control" value="@Model.SdtKhachHang" name="SdtKhachHang" maxlength="11">
                            <div class="">@Html.ValidationMessageFor(n => n.SdtKhachHang)</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Phí dịch vụ</label>
                            <div class="input-group">
                                <input type="number" class="form-control" value="@Model.PhiDichVu" name="PhiDichVu">
                                <span class="currency">VNĐ</span>
                            </div>
                            <div class="">@Html.ValidationMessageFor(n => n.PhiDichVu)</div>
                        </div>
                    </div>    
                </div>
            </div>

            <div class="form-section">
                <h4 class="section-subtitle">Thông tin dịch vụ</h4>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Khu vực<span class="required-mark">*</span></label>
                            <select class="form-control" name="khuVuc" id="khuVucSelect">
                                <option value=null selected>---Chọn Khu Vực---</option>
                                <option value="Tan Hanh">Tân Hạnh</option>
                                <option value="Hoa An">Hóa An</option>
                                <option value="Tan Hoa">Tân Hòa</option>
                                <option value="Tan Hiep">Tân Hiệp</option>
                                <option value="Thong Nhat">Thống Nhất</option>
                                <option value="Trang Dai">Trảng Dài</option>
                            </select>
                            <div class="">@Html.ValidationMessageFor(n => n.KhuVuc)</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @{
                                QuanLyNhanSuEntities db = new QuanLyNhanSuEntities();
                                var listNvKyThuat = db.NhanViens.Where(n => n.MaPhongBan == "kythuat" && n.KhuVuc == "Tan Hanh").ToList();
                                var listNv = db.NhanViens.Where(n => n.MaPhongBan == "kythuat" && n.KhuVuc != "Tan Hanh").ToList();
                            }
                            <label>Mã nhân viên triển khai</label>
                            <select name="MaNVTrienKhai" class="form-control" id="nhanVienSelect">
                            </select>
                            <div class="">@Html.ValidationMessageFor(n => n.MaNVTrienKhai) @ViewBag.Error</div>
                        </div>
                    </div>
                </div>

            <div class="text-center mt-4">
                <button type="submit" class="btn btn-submit">
                    <i class="fa fa-plus-square"></i>
                    Hoàn Tất
                </button>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    <script>
        $(document).ready(function () {
            // Bắt sự kiện khi select thay đổi
            $('#khuVucSelect').change(function () {
    var selectedKhuVuc = $(this).val();

    $.ajax({
        url: '@Url.Action("FetchNhanVienByKhuVuc", "TrienKhaiSwap")',
        type: 'POST',
        data: { khuVuc: selectedKhuVuc },
        success: function (data) {
            // Clear và cập nhật dropdown nhân viên
            var nhanVienSelect = $('#nhanVienSelect');
            nhanVienSelect.empty();
            nhanVienSelect.append('<option value="">-- Chọn nhân viên --</option>');
            data.forEach(function (nv) {
                nhanVienSelect.append(
                    $('<option></option>')
                        .val(nv.MaNhanVien)
                        .text(nv.TenNhanVien + " - Khu Vực " + nv.KhuVuc)
                );
            });
        },
        error: function (xhr, status, error) {
            console.error('Error:', error);
        }
    });
});
        });
    </script>
}


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        // Validate form khi submit
        $('#swapForm').on('submit', function (e) {
            e.preventDefault();
            let isValid = true;

            // Validate mã hợp đồng
            const maHopDong = $('input[name="maHopDong"]').val();
            if (!maHopDong || !/^[A-Za-z0-9]*$/.test(maHopDong)) {
                $('input[name="maHopDong"]').addClass('error');
                isValid = false;
            }

            // Validate tên khách hàng
            if (!$('input[name="tenKhachHang"]').val()) {
                $('input[name="tenKhachHang"]').addClass('error');
                isValid = false;
            }

            // Validate số điện thoại
            const sdt = $('input[name="sdtKhachHang"]').val();
            if (sdt && !/^[0-9]*$/.test(sdt)) {
                $('input[name="sdtKhachHang"]').addClass('error');
                isValid = false;
            }

            // Validate khu vực
            if (!$('select[name="khuVuc"]').val()) {
                $('select[name="khuVuc"]').addClass('error');
                isValid = false;
            }

            if (isValid) {
                // Xử lý submit form
                console.log('Form submitted successfully');
            }
        });

        // Remove error class khi input thay đổi
        $('.form-control').on('input', function () {
            $(this).removeClass('error');
        });
    });
</script>
}


