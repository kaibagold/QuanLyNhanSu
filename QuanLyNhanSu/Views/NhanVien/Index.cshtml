@model IEnumerable<QuanLyNhanSu.Models.ChiTietLuong>

@{
    ViewBag.Title = "Chi tiết lương";
}
<link rel="stylesheet" href="~/Content/css/nhanvien_index.css" />
@Styles.Render("~/Content/Luong/css")
<div style="padding-top: 15px; padding-left: 15px; background-color: #f1f1f1; color: cornflowerblue">
    <ol style="">
        <i class="fa fa-dashboard"></i>
        <a href="@Url.Action("index","Home")" style="font-size:15px">Trang Chủ / </a>
        <a style="font-size:15px"> Lương Nhân Viên</a>
    </ol>
</div>
<div class="detail_nv" style=" background-image: url('/Content/anh/bg_login_main.png'); background-size: cover; /* Hình nền bao phủ toàn bộ div */ background-repeat: no-repeat; /* Không lặp lại */ background-position: center center; /* Đặt ảnh ở giữa */">
    <div class="salary-form">
        <h2>CHI TIẾT THÔNG TIN LƯƠNG</h2>

        <!-- Thông tin nhân viên -->
        <div class="info-field">
            <label>Tên nhân viên:</label>
            <span>@Session["TenNhanVien"]</span>
        </div>
        <div class="info-field">
            <label>Mã nhân viên:</label>
            <span>@Session["MaNhanVien"]</span>
        </div>
        <div class="info-field">
            <label>Ngày sinh:</label>
            <span>@Session["NgaySinh"]</span>
        </div>
        <div class="info-field">
            <label>Phòng ban:</label>
            <span>@Session["PhongBan"]</span>
        </div>

        <!-- Thời gian chọn tháng và năm -->
        <div class="time-selection">
            <label for="month">Chọn tháng:</label>
            <input class="calendar" type="month" id="month" name="month">
            <p id="displayMonth" style="margin-top:5px">@Session["selectedMonth"]</p>
            <a class="btn btn-primary" href="@Url.Action("LichSuLuong","login")" style="height: 33px; background-color: #e76f51">Lịch sử nhận lương</a>
        </div>

        <!-- Bảng thông tin lương -->
        <table class="salary-table">
            <tr>
                <th>Lương Cơ Bản</th>
                <th>BHXH</th>
                <th>BHYT</th>
                <th>Phụ Cấp</th>
            </tr>
            @foreach (var item in Model.Where(nv => nv.MaChiTietBangLuong == "t" + Session["selectedMonth"] + "n" + DateTime.Now.Year))
            {
                <tr>
                    <td id="basicSalary">@String.Format("{0:#,#}", @item.LuongCoBan).Replace(",", ",")</td>
                    <td id="bhxh">@String.Format("{0:#,#}", @item.BHXH).Replace(",", ",")</td>
                    <td id="bhyt">@String.Format("{0:#,#}", @item.BHYT).Replace(",", ",")</td>
                    <td id="phuCap">@String.Format("{0:#,#}", @item.PhuCap).Replace(",", ",")</td>
                </tr>
            }
            <tr>
                <th>Thuế TNCN</th>
                <th>Tiền Thưởng</th>
                <th>Tiền Phạt</th>
                <th>Tổng Tiền</th>
            </tr>
            @foreach (var item in Model.Where(nv => nv.MaChiTietBangLuong == "t" + Session["selectedMonth"] + "n" + DateTime.Now.Year))
            {
                <tr>
                    <td id="ttncn">@String.Format("{0:#,#}", @item.ThueThuNhap).Replace(",", ",")</td>
                    <td id="tienThuong">@String.Format("{0:#,#}", @item.TienThuong).Replace(",", ",")</td>
                    <td id="tienPhat">@String.Format("{0:#,#}", @item.TienPhat).Replace(",", ",")</td>
                    <td class="total-cell" id="tongTien">@String.Format("{0:#,#}", @item.TongTienLuong).Replace(",", ",")</td>
                </tr>
            }
        </table>
        <script src="~/Content/js/nhanvien_index.js"></script>
    </div>
</div>