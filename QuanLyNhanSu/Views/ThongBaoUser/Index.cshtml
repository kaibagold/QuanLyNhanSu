@using QuanLyNhanSu.Models
@using QuanLyNhanSu.Controllers;
@{
    ViewBag.Title = "Thông báo";
    QuanLyNhanSuEntities db = new QuanLyNhanSuEntities();
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/MaterialDesign-Webfont/5.3.45/css/materialdesignicons.css" integrity="sha256-NAxhqDvtY0l4xn+YVa6WjAcmd94NNfttjNsDmNatFVc=" crossorigin="anonymous" />
<style>
    body {
        background-color: #f0f2f5;
    }

    .dropdown-list-image {
        position: relative;
        height: 40px;
        width: 40px;
    }

        .dropdown-list-image img {
            height: 40px;
            width: 40px;
        }

    .btn-light {
        color: #2cdd9b;
        background-color: #e5f7f0;
        border-color: #d8f7eb;
    }

    .notification-item {
        cursor: pointer;
        display: flex;
        border: 2px double;
        background-color: floralwhite;
        margin: 5px;
        height: 50px;
    }

        .notification-item :hover {
            text-decoration: none;
        }

    .TimeSinceNotification {
        margin: 8px auto auto -14px;
        width: 130px;
        opacity: 0.5;
    }
</style>
<link rel="stylesheet" href="~/Content/css/EditProfile.css" />
<section class="editProfile" style="height:550px">
    <div class="container">
        <div class="row gutters">
            <div class="col-xl-3 col-lg-3 col-md-12 col-sm-12 col-12">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="account-settings">
                            <div class="user-profile">
                                <div class="user-avatar">
                                    @{
                                        string maNV = Session["MaNhanVien"].ToString();
                                        var nv = db.NhanViens.FirstOrDefault(n => n.MaNhanVien == maNV);
                                        if (nv.HinhAnh == null)
                                        {
                                            <img style="" src="~/Content/anh/img_avt/avt_profile_default.png" alt="Maxwell Admin">
                                        }
                                        else
                                        {
                                            <img style="border: 1px solid; background: linear-gradient(to right, orange, #ffe0b3) border-box;" src="~/Content/anh/img_avt/@nv.HinhAnh" alt="Maxwell Admin">
                                        }
                                    }
                                </div>

                                <div>
                                    <h5 class="user-name" id="name">@nv.HoTen</h5>
                                </div>
                                <h6 class="user-email">@nv.Email</h6>
                            </div>
                            <div class="about">
                                <h5>@nv.MaNhanVien</h5>
                                <p>Để đảm bảo an toàn, người dùng cần tránh chia sẻ thông tin trên các nền tảng không đáng tin cậy, sử dụng mật khẩu mạnh, kích hoạt xác thực hai yếu tố và thường xuyên kiểm tra các quyền riêng tư trên ứng dụng.</p>
                                @{
                                    if (TempData["SuccessMessage"] != null)
                                    {
                                        <div class="alert alert-success thong_bao_update">
                                            @TempData["SuccessMessage"]
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-9 col-lg-9 col-md-12 col-sm-12 col-12">
                <div class="card h-100" style="height:500px">
                    <div style="padding-top: 15px; padding-left: 15px">
                        <ol style="">
                            <i class="fa fa-dashboard"></i>
                            <a href="@Url.Action("index","Home")" style="font-size:15px">Trang Chủ / </a>
                            <a style="font-size:15px"> Thông Báo</a>
                        </ol>
                    </div>
                    <hr />
                    <div class="container">
                        <div class="row">
                            <div>
                                <div class="box shadow-sm rounded bg-white mb-3" style="background-color: aliceblue; height: max-content; margin-left: 30px;">
                                    <div class="box-title border-bottom p-3">
                                        <h5 class="m-0">Recent</h5>
                                    </div>
                                    <div class="box-body p-0">
                                        @{
                                            var nvien = db.NhanViens.ToList();
                                            foreach (var item in Model)
                                            {
                                                string colorThongBao, loaiThongBao = "";
                                                string avtNhanVien = nvien.Where(n => n.MaNhanVien == item.MaNVGuiTB).Select(n => n.HinhAnh).FirstOrDefault();
                                                if (item.TrangThai == 0)
                                                {
                                                    colorThongBao = "floralwhite";//chưa đọc
                                                }
                                                else
                                                {
                                                    colorThongBao = "white";//đã đọc
                                                }
                                                if (item.LoaiThongBao == "nhanvattu")
                                                {
                                                    loaiThongBao = item.MaNVGuiTB + " đã duyệt phiếu đề nghị xuất vật tư";
                                                }
                                                else if(item.LoaiThongBao == "capmatkhau")
                                                {
                                                    loaiThongBao = item.MaNVGuiTB + " đã cấp lại mật khẩu mới";
                                                }
                                                else
                                                {
                                                    loaiThongBao = " Bạn có ca mới, vui lòng nhận ca !";
                                                }
                                                <a href="@Url.Action("ChiTietThongBao", "ThongBaoUser", new {@id = @item.Id })" style="color: black; display: flex; text-decoration: none;">
                                                    <div class="p-3 notification-item" style="background-color:@colorThongBao">
                                                        <div class="dropdown-list-image mr-3">
                                                            <img class="rounded-circle" style="border-radius: 50%;border:1px solid " src="~/Content/anh/img_avt/@avtNhanVien" alt="" />
                                                        </div>
                                                        <div class="font-weight-bold mr-3" style="margin-left: 10px;width:500px">
                                                            <div class="text-truncate" style="font-weight: bold; text-transform: uppercase;">TIÊU ĐỀ: @item.TieuDe</div>
                                                            <div class="small" style="font-weight:normal">@loaiThongBao</div>
                                                        </div>
                                                        <div class="TimeSinceNotification">@ThongBaoUserController.GetTimeSinceNotification(item.ThoiGianGuiTB)</div>
                                                        <span class="ml-auto mb-auto" style="margin-right:0px">
                                                            <div class="btn-group">
                                                                <button type="button" class="btn btn-light btn-sm rounded" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                                                    <i class="mdi mdi-dots-vertical"></i>
                                                                </button>
                                                               
                                                            </div>
                                                            <br />

                                                        </span>
                                                    </div>
                                                </a>
                                            }
                                        }

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>


