@{
    ViewBag.Title = "Đăng nhập";
    Layout = null;
}
<head>
    <title>Đăng Nhập</title>
    <link rel="icon" type="image/x-icon" href="~/Content/anh/icon/Fpt-icon.png">
</head>
<div class="container">
    <link rel="stylesheet" href="~/Content/css/login_main.css">
    <div class="info-section">
        <h1>TRANG THÔNG TIN DÀNH RIÊNG CHO NHÂN VIÊN FPT</h1>
        <p>Quản lý thông tin nhân viên, hợp đồng khách hàng và tất cả dịch vụ trực tuyến FPT khách hàng đang sử dụng. Đăng ký nâng cấp, mua mới dịch vụ, thanh toán hóa đơn và chuyển đổi phương thức thanh toán...</p>
        <a href="#">HƯỚNG DẪN SỬ DỤNG</a>
    </div>
    <div class="login-section">
        <h2>ĐĂNG NHẬP</h2>
        <form method="post">
            @Html.AntiForgeryToken()
            <input type="text" name="MaNhanVien" placeholder="UserName" required autofocus>
            <div class="password-container">
                <input type="password" name="MatKhau" id="password" class="password-input" placeholder="Password" required>
                <span class="toggle-password" onclick="togglePassword()">👁️</span>
            </div>
            <button type="submit">Login</button>
        </form>
        <span class="text-danger" style="font-size: 14px; color: red;"> @ViewBag.err</span>
        <a href="@Url.Action("QuenMatKhau","login")">Quên mật khẩu</a>
        <script src="~/Content/js/index_login.js"></script>
    </div>
</div>