@using QuanLyNhanSu.Models
@model List<ChiTietSwap>
@using System.IO;
@{
    ViewBag.Title = "Lương Swap";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    QuanLyNhanSuEntities db = new QuanLyNhanSuEntities();
}

<link rel="stylesheet" href="~/Content/css/EditProfile.css" />
<link rel="stylesheet" href="~/Content/admin-lte/css/AdminLTE.min.css" />
<link rel="stylesheet" href="~/Content/bootstrap.min.css" />
<link rel="stylesheet" href="~/Content/datatables.min.css" />
@*Css Table data*@
@section Styles{
    @Styles.Render("~/bundles/datatables/css")
}



<section class="editProfile" style="height:550px">
    <div class="container">
        <div class="row gutters">
            <div class="col-xl-3 col-lg-3 col-md-12 col-sm-12 col-12">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="account-settings">
                            <div class="user-profile">
                                <div class="user-avatar">
                                    @{
                                        string maNV = Session["MaNhanVien"].ToString();
                                        var nv = db.NhanViens.FirstOrDefault(n => n.MaNhanVien == maNV);
                                        if (nv.HinhAnh == null)
                                        {
                                            <img style="" src="~/Content/anh/img_avt/avt_profile_default.png" alt="Maxwell Admin">
                                        }
                                        else
                                        {
                                            <img style="border: 1px solid; background: linear-gradient(to right, orange, #ffe0b3) border-box;" src="~/Content/anh/img_avt/@nv.HinhAnh" alt="Maxwell Admin">
                                        }
                                    }
                                </div>

                                <div>
                                    <h5 class="user-name" id="name">@nv.HoTen</h5>
                                </div>
                                <h6 class="user-email">@nv.Email</h6>
                            </div>
                            <div class="about">
                                <h5>@nv.MaNhanVien</h5>
                                <p>Để đảm bảo an toàn, người dùng cần tránh chia sẻ thông tin trên các nền tảng không đáng tin cậy, sử dụng mật khẩu mạnh, kích hoạt xác thực hai yếu tố và thường xuyên kiểm tra các quyền riêng tư trên ứng dụng.</p>
                                @{
                                    if (TempData["SuccessMessage"] != null)
                                    {
                                        <div class="alert alert-success thong_bao_update">
                                            @TempData["SuccessMessage"]
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-9 col-lg-9 col-md-12 col-sm-12 col-12">
                <div class="card h-100" style="height:500px">
                    <div style="padding-top: 15px; padding-left: 15px ">
                        <ol style="">
                            <i class="fa fa-dashboard"></i>
                            <a href="@Url.Action("index", "Home")" style="font-size:15px">Trang Chủ / </a>
                            <a style="font-size:15px"> Lương swap</a>
                            <a class="btn btn-success" style="margin-right:15px;float:right" href="@Url.Action("XuatFileLuong", "login")"> Xuất file Excel</a>

                        </ol>
                    </div>
                    <hr />
                    <select name="thang" id="thang" style="width: 130px; height: 33px; margin-top: -10px; margin-left: 10px; background-color: #dff0d8">
                        <option value="">-- Chọn tháng --</option>
                        <option value="1">Tháng 1</option>
                        <option value="2">Tháng 2</option>
                        <option value="3">Tháng 3</option>
                        <option value="4">Tháng 4</option>
                        <option value="5">Tháng 5</option>
                        <option value="6">Tháng 6</option>
                        <option value="7">Tháng 7</option>
                        <option value="8">Tháng 8</option>
                        <option value="9">Tháng 9</option>
                        <option value="10">Tháng 10</option>
                        <option value="11">Tháng 11</option>
                        <option value="12">Tháng 12</option>
                    </select>
                    <a class="btn btn-primary">Tổng : @Model.Count ca</a>
                    @{ var TongLuong = Convert.ToInt32(Model.Count) * 60000;}
                    <a class="btn btn-primary">Lương : @TongLuong VNĐ</a>
                    <div class="table-responsive" style="margin:10px;border: 1px solid">
                        <table id="table-taikhoan" class="table table-bordered table-striped table-hover">
                            <thead>
                                <tr class="success">
                                    <th>
                                        Mã hợp đồng
                                    </th>

                                    <th>
                                        Khu vực
                                    </th>
                                    <th>
                                        Khách hàng
                                    </th>
                                    <th>
                                        Số điện thoại
                                    </th>
                                    <th>
                                        Hoàn tất
                                    </th>

                                    <th>
                                        Phí dịch vụ
                                    </th>

                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.MaHopDong)
                                        </td>

                                        <td>
                                            @item.KhuVuc
                                        </td>
                                        <td>
                                            @item.TenKhachHang
                                        </td>
                                        <td>
                                            @item.SdtKhachHang

                                        </td>
                                        <td>
                                            @String.Format("{0:dd/MM/yyyy}", @item.ThoiGianHoanTat)
                                        </td>
                                        <td>
                                            @{
                                                var t = decimal.Parse(item.PhiDichVu);
                                            }

                                            @String.Format("{0:#,#}", t).Replace(",", ",")
                                        </td>

                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts{
    @Scripts.Render("~/bundles/adminlte/js")
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/datatable") @*Css tìm kiếm ,phân trang Table data*@
    @Scripts.Render("~/bundles/bootstrap")@*Phân trang*@
}
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script>
    // Lấy thẻ select
    const monthSelect = document.getElementById('thang');
    // Hàm lấy tham số tháng từ URL
    function getURLParam(param) {
        const urlParams = new URLSearchParams(window.location.search);
        return urlParams.get(param);
    }
    // Thiết lập giá trị tháng khi tải trang
    const selectedMonth = getURLParam('month');
    if (selectedMonth) {
        monthSelect.value = selectedMonth; // Gán giá trị đã chọn vào thẻ select tháng
    }
    // Gắn sự kiện change
    monthSelect.addEventListener('change', function () {
        // Lấy giá trị được chọn
        const selectedMonth = monthSelect.value;
        // Nếu người dùng chọn một tháng (không phải giá trị mặc định)
        if (selectedMonth) {
            // Thêm giá trị tháng vào URL dưới dạng tham số
            const url = new URL(window.location.href);
            url.searchParams.set('month', selectedMonth);
            // Load lại trang với URL mới
            window.location.href = url.toString();
        }
    });
</script>

