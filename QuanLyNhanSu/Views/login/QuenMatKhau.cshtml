@{
    ViewBag.Title = "Quên mật khẩu";
    Layout = null;
}
<div class="container">
    <link rel="stylesheet" href="~/Content/css/login_main.css">
    <div class="info-section">
        <h1>TRANG THÔNG TIN DÀNH RIÊNG CHO NHÂN VIÊN FPT</h1>
        <p>Quản lý thông tin nhân viên, hợp đồng khách hàng và tất cả dịch vụ trực tuyến FPT khách hàng đang sử dụng. Đăng ký nâng cấp, mua mới dịch vụ, thanh toán hóa đơn và chuyển đổi phương thức thanh toán...</p>
        <a href="#">HƯỚNG DẪN SỬ DỤNG</a>
    </div>
    <div class="login-section">
        <h2>QUÊN MẬT KHẨU</h2>
        <form method="post">
            @Html.AntiForgeryToken()
            <input type="text" name="MaNhanVien" placeholder="Mã nhân viên" required autofocus autocomplete="off">
            <div class="password-container">
                <input type="text" name="MatKhau" id="password" class="password-input" placeholder="Email" required autocomplete="off">
            </div>
            <button type="submit">Xác Nhận</button>
        </form>
        <span class="text-danger" style="font-size: 14px; color: red;"> @ViewBag.err</span>
        <a href="@Url.Action("Login","login")">Quay lại đăng nhập</a>
        <script src="~/Content/js/index_login.js"></script>
    </div>
</div>