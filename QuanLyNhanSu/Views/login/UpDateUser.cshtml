@*@model QuanLyNhanSu.Models.NhanVien*@
@using QuanLyNhanSu.Models
@{
    ViewBag.Title = "Cập nhật thông tin nhân viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model UserValidate
@{
    QuanLyNhanSuEntities db = new QuanLyNhanSuEntities();
}

<link rel="stylesheet" href="~/Content/css/EditProfile.css" />
<div style="padding-top: 15px; padding-left: 15px; background-color: #f1f1f1;">
    <ol style="">
        <i class="fa fa-dashboard"></i>
        <a href="@Url.Action("index","Home")" style="font-size:15px">Trang Chủ / </a>
        <a style="font-size:15px"> Thông Tin Cá Nhân</a>
    </ol>
</div>
<section class="editProfile">
    <div class="container">
        <form method="post" role="form" enctype="multipart/form-data">
            <div class="row gutters">
                <div class="col-xl-3 col-lg-3 col-md-12 col-sm-12 col-12">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="account-settings">
                                <div class="user-profile">
                                    <div class="user-avatar">
                                        @{
                                            if (Model.HinhAnh == null || ViewBag.FileExists == false)
                                            {
                                                <img style="border:1px solid" src="~/Content/anh/img_avt/avt_profile_default.png" alt="Maxwell Admin">
                                            }
                                            else
                                            {
                                                <img style="border: 1px solid; background: linear-gradient(to right, orange, #ffe0b3) border-box;" src="~/Content/anh/img_avt/@Model.HinhAnh" alt="Maxwell Admin">
                                            }
                                        }

                                        <i onclick="triggerFileUpload()" class="fa fa-edit edit_avt" title="Sửa ảnh"></i>
                                        <input type="file" id="fileInput" name="HinhAnh" style="display: none;" />
                                    </div>

                                    <div >
                                        <h5 class="user-name user-name-display" id="name">@Model.HoTen</h5>
                                        <i id="edit-icon" class="fa fa-edit edit_name" title="Sửa tên"></i>
                                    </div>
                                    <input class="user-name" id="name-input" name="HoTen" type="text" style="display:none;text-align:center" 
                                           value="@Model.HoTen" />
                                    @Html.ValidationMessageFor(model => model.HoTen)
                                    <h6 class="user-email">@Model.Email</h6>
                                </div>
                                <div class="about">
                                    <h5>@Model.MaNhanVien</h5>
                                    <p>I'm Yuki. Full Stack Designer I enjoy creating user-centric, delightful and human experiences.</p>
                                    @{
                                        if (TempData["SuccessMessage"] != null)
                                        {
                                            <div class="alert alert-success thong_bao_update">
                                                @TempData["SuccessMessage"]
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-9 col-lg-9 col-md-12 col-sm-12 col-12">
                    <div class="card h-100">

                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true)
                        @Html.HiddenFor(model => model.MaNhanVien)
                        <div class="card-bodyy">
                            <div class="row gutters" style="padding:15px">
                                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                    <h6 class="mb-2 text-primary" style="font-size: 20px; color: #fc7321;text-align:center">Thông Tin Cá Nhân</h6>
                                    <hr />
                                </div>

                                <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                                    <div class="form-group">
                                        <label for="fullName">Mật Khẩu</label>
                                        <input class="form-control" type="password" name="MatKhau" value="@Model.MatKhau" placeholder="Enter full name">
                                        @Html.ValidationMessageFor(model => model.MatKhau)
                                    </div>
                                </div>
                                <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                                    <div class="form-group">
                                        <label for="eMail">Xác Nhận Mật Khẩu</label>
                                        <input class="form-control" type="password" name="XacNhanMatKhau" value="@Model.XacNhanMatKhau">
                                        @Html.ValidationMessageFor(model => model.XacNhanMatKhau)
                                    </div>
                                </div>
                                <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                                    <div class="form-group">
                                        <label for="phone">Ngày Sinh</label>
                                        <input class="form-control"
                                               value="@String.Format("{0:MM-dd-yyyy}", @Model.NgaySinh)"
                                               type="datetime" name="NgaySinh"
                                               
                                               required pattern="[0-9]{2}-[0-9]{2}-[0-9]{4}"
                                               title="Nhập đúng định dạng MM-DD-YYYY" />

                                        @*<input class="form-control" type="date" name="NgaySinh" value="@Model.NgaySinh" />*@
                                        @Html.ValidationMessageFor(model => model.NgaySinh)
                                    </div>
                                </div>
                                <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                                    <div class="form-group">
                                        <label for="website">Quê Quán</label>
                                        <input class="form-control" type="text" name="QueQuan" value="@Model.QueQuan" />
                                        @Html.ValidationMessageFor(model => model.QueQuan)
                                    </div>
                                </div>
                            </div>
                            <div class="row gutters" style="padding:15px">
                                @*<div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                    <h6 class="mt-3 mb-2 text-primary">Address</h6>
                                </div>*@
                                <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                                    <div class="form-group" style="display:flex;flex-direction:column">
                                        <label for="Street">Giới Tính</label>
                                        @{
                                            string check0 = string.Empty;
                                            string check1 = string.Empty;
                                            string check2 = string.Empty;
                                            switch (@Model.GioiTinh)
                                            {
                                                case 0:
                                                    check0 = "selected";
                                                    break;
                                                case 1:
                                                    check1 = "selected";
                                                    break;
                                                default:
                                                    check2 = "selected";
                                                    break;
                                            }
                                        }
                                        <select name="GioiTinh" style="width:200px;height:40px;font-size:16px" >
                                            <option name="GioiTinh" value="1" @check1>Nam</option>
                                            <option name="GioiTinh" value="0" @check0>Nữ</option>
                                            <option name="GioiTinh" value="1" @check2>Khác</option>
                                        </select>
                                        
                                    </div>
                                </div>

                                <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                                    <div class="form-group">
                                        <label for="ciTy">Dân Tộc</label>
                                        <input class="form-control" type="text" name="DanToc" value="@Model.DanToc" />
                                        @Html.ValidationMessageFor(model => model.DanToc)
                                    </div>
                                </div>
                                <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                                    <div class="form-group">
                                        <label for="sTate">Số Điện Thoại</label>
                                        <input class="form-control" type="text" name="sdt_NhanVien" value="@Model.sdt_NhanVien" />
                                        @Html.ValidationMessageFor(model => model.sdt_NhanVien)
                                    </div>
                                </div>
                                <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                                    <div class="form-group">
                                        <label for="zIp">CMND</label>
                                        <input class="form-control" type="text" name="CMND" value="@Model.CMND" />
                                        @Html.ValidationMessageFor(model => model.CMND)
                                    </div>
                                </div>
                            </div>
                            <hr style="width: 97%;" />
                            <div class="row gutters">
                                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                    <div style="">
                                        <button type="submit" id="submit" name="submit" value="Cập nhật" class="btn" style="margin-left: 40%; cursor: pointer">
                                            Cập Nhật</button>
                                        <button type="button" onclick="window.location.href='@Url.Action("Index","Home")';"  class="btn" style="background-color: darkgray; cursor: pointer">
                                            Quay Lại</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </form>
    </div>
</section>
<script>
    const nameElement = document.getElementById("name");
    const inputElement = document.getElementById("name-input");
    const editIcon = document.getElementById("edit-icon");

    editIcon.addEventListener("click", () => {
        inputElement.style.display = "block";
        nameElement.style.display = "none";
        editIcon.style.display = "none"
        inputElement.value = nameElement.textContent;
        inputElement.focus();
    });

    inputElement.addEventListener("blur", () => {
        nameElement.textContent = inputElement.value;
        inputElement.style.display = "none";
        nameElement.style.display = "block";
        editIcon.style.position = "absolute";
        editIcon.style.display = "inline-block"
    });
    function triggerFileUpload() {
        document.getElementById('fileInput').click(); // Kích hoạt sự kiện click của input file
    }
    //hiển thị thông báo trong vòng 2s
    $(document).ready(function () {
        setTimeout(function () {
            $('.thong_bao_update').fadeOut('slow');
        }, 2000); // Ẩn thông báo sau 2 giây
    });
</script>